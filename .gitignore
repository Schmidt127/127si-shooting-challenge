# Season-simulation runtime state and ad-hoc helpers.  Curated evidence is
# intentionally committed only through the documented evidence index; do not
# add raw registries, locks, logs, or one-off helpers by accident.
tools/season_simulation/run_registries/*
!tools/season_simulation/run_registries/.gitignore
tools/season_simulation/.season-sim-execute.lock
tools/season_simulation/_*.py
docs/audits/readiness-*/_scratch*/
docs/audits/readiness-*/*-live.log

node_modules/

# Local Cursor/agent git worktrees (never commit)
.worktrees/
